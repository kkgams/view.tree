          "node": {
            "minWidth": 120,
            "minHeight": 48,
            "paddingX": 12,
            "paddingY": 10
          },
          "textLayout": {
            "titleFontPx": 18,
            "dataFontPx": 14,
            "lineHeight": 20,
            "maxVisibleData": 4
          },
          "theme": {
            "clear": [
              0.12,
              0.12,
              0.14,
              1
            ],
            "text": [
              1,
              1,
              1,
              1
            ],
            "textMuted": [
              0.8,
              0.8,
              0.8,
              1
            ],
            "selection": [
              0.3,
              0.6,
              1,
              1
            ],
            "edge": [
              0.7,
              0.7,
              0.7,
              1
            ]
          },
          "edge": {
            "handleMin": 30,
            "handleMax": 120,
            "halfWidthPx": 1,
            "glowPx": 2,
            "aaPx": 1
          },
          "text": {
            "aa": 8,
            "effect": "none",
            "stroke": 2.5,
            "glow": 2,
            "shadowX": 4,
            "shadowY": -4,
            "source": {
              "metaUrl": "dev-assets/font.json",
              "atlasUrl": "dev-assets/font.png",
              "channels": 3
            }
          },
          "nineSlices": {
            "idle": {
              "textureUrl": "dev-assets/node-idle.png",
              "left": 4,
              "right": 4,
              "top": 4,
              "bottom": 4
            },
            "hover": {
              "textureUrl": "dev-assets/node-hover.png",
              "left": 4,
              "right": 4,
              "top": 4,
              "bottom": 4
            },
            "selected": {
              "textureUrl": "dev-assets/node-selected.png",
              "left": 4,
              "right": 4,
              "top": 4,
              "bottom": 4
            }
          }
        }
      },
      "view-tree-parent": {
        "url": "src/view.tree-parent/views/view-tree-parent.js",
